rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════╗
// ║  ESTE ARQUIVO É DO **FIRESTORE**, NÃO DO STORAGE.                    ║
// ║  Cole SOMENTE em: Console › Firestore Database › aba "Regras".       ║
// ║  Confira antes de publicar: a linha abaixo diz `cloud.firestore`.    ║
// ╚══════════════════════════════════════════════════════════════════════╝

// PARCIAL — regras do Firestore, VERSÃO 2 (correção do P0). FECHADA.
//
// ⚠️ ORDEM OBRIGATÓRIA PARA PUBLICAR:
//   Fase 1 — todos os clientes na v69+ (gravam os campos espelhados).  [feito]
//   Fase 2 — Diagnóstico › "Migrar campos de segurança" até dar verde.  [feito]
//   Fase 3 — publicar este conteúdo no Console › Firestore › Regras.
// Também é preciso estar na v73+ do app: antes dela, seis telas liam a coleção
// INTEIRA, o que estas regras negam (ver varrerKv no index.html).
// Rollback: republicar `firestore.rules` (versão anterior) — 30 segundos.
//
// O QUE MUDA
//   Antes: qualquer pessoa logada lia, alterava e APAGAVA tudo que não fosse
//          pro_*. Como o cadastro é aberto, isso valia para qualquer um.
//   Agora: acesso por DONO e por EQUIPE. Quem não foi aprovado não lê a equipe.
//
// POR QUE OS CAMPOS ESPELHADOS
//   O app grava o conteúdo como string JSON em `v`, e as regras não sabem ler
//   JSON dentro de string. Por isso `dono`, `donoEmail`, `equipe`, `perfil` e
//   `aprovado` existem como campos reais (ver camposSeguranca no index.html).
//
// ⚠️ `dono` DE UM pro_ VEM DO CONTEÚDO, NÃO DA CHAVE  (v159)
//   Em 14/10/2026 os dados de um atleta foram gravados dentro do pro_ de
//   outro. As regras abaixo já exigiam `dono == request.auth.uid` — e deixaram
//   passar, porque o `dono` era tirado da CHAVE: gravar no próprio pro_
//   satisfazia a regra, qualquer que fosse o conteúdo.
//   Agora camposSeguranca lê `_dono` de DENTRO do objeto. Um documento com os
//   dados de outro atleta chega ao servidor declarando o dono errado, e estas
//   mesmas regras o recusam — mesmo que o app esteja desatualizado ou adulterado.
//   NÃO volte a derivar `dono` da chave: é isso que sustenta a garantia.
//   (As versões diárias usam pro_<uid>_bk<N>, mesmo prefixo e mesmas regras.)
//
// APROVAÇÃO
//   Ninguém nasce aprovado. Entrar numa equipe deixa o cadastro PENDENTE; o
//   técnico libera o atleta e o administrador libera o técnico. Equipes novas
//   são criadas exclusivamente pelo administrador.

service cloud.firestore {
  match /databases/{database}/documents {
    // Grupos v174: permissões estruturadas, independentes do nome do clube e
    // do perfil global PRO. Nenhum destes papéis dá leitura aos pro_*.
    function gAuth() { return request.auth != null && request.auth.token.email_verified == true; }
    function gAdmin() { return gAuth() && request.auth.token.email.lower() == 'barbato.bruno@gmail.com'; }
    function gRoot(g) { return get(/databases/$(database)/documents/groups/$(g)).data; }
    function gOwner(g) { return gAdmin() || (gAuth() && gRoot(g).ownerUid == request.auth.uid); }
    function gMember(g) { return gAuth()
      && exists(/databases/$(database)/documents/group_members/$(g + '_' + request.auth.uid))
      && get(/databases/$(database)/documents/group_members/$(g + '_' + request.auth.uid)).data.ativo == true; }
    function gProfessional(u) { return exists(/databases/$(database)/documents/professionals/$(u))
      && get(/databases/$(database)/documents/professionals/$(u)).data.status == 'aprovado'; }
    function gCoach(g) { return gMember(g) && gProfessional(request.auth.uid)
      && get(/databases/$(database)/documents/group_members/$(g + '_' + request.auth.uid)).data.role == 'tecnico'; }
    function gOpen(g) { return gRoot(g).arquivado == false; }
    function gInvite(d) {
      let c = get(/databases/$(database)/documents/group_invites/$(d.inviteId)).data;
      let depois = getAfter(/databases/$(database)/documents/group_invites/$(d.inviteId)).data;
      return gAuth() && d.uid == request.auth.uid && d.email == request.auth.token.email.lower()
        && c.email == d.email && c.groupId == d.groupId && c.role == d.role
        && c.status == 'aberto' && c.expiraEm > request.time.toMillis() && gOpen(d.groupId)
        && depois.status == 'aceito' && depois.aceitoPor == request.auth.uid;
    }
    function gMemberShape(d,id) { return d.keys().hasOnly(['groupId','uid','email','nome','role','ativo','criadoEm','inviteId'])
      && id == d.groupId + '_' + d.uid && d.role in ['atleta','tecnico']
      && d.nome is string && d.nome.size() <= 100 && d.email is string && d.ativo is bool; }
    match /groups/{g} {
      allow read: if gAdmin() || (gAuth() && resource.data.ownerUid == request.auth.uid) || gMember(g);
      allow create: if gAuth() && request.resource.data.keys().hasOnly(['nome','ownerUid','verificacao','arquivado','criadoEm','transferUid','transferExp'])
        && g.matches('[a-f0-9]{32}') && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
        && request.resource.data.verificacao == 'nao_verificado' && request.resource.data.arquivado == false
        && request.resource.data.transferUid == null && request.resource.data.transferExp == 0;
      allow update: if gAdmin()
        || (gOwner(g) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','arquivado','transferUid','transferExp'])
          && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
          && (request.resource.data.transferUid == null
            || exists(/databases/$(database)/documents/group_members/$(g + '_' + request.resource.data.transferUid))))
        || (gAuth() && resource.data.transferUid == request.auth.uid && resource.data.transferExp > request.time.toMillis()
          && gMember(g) && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.transferUid == null && request.resource.data.transferExp == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','transferUid','transferExp']));
      allow delete: if gAdmin();
    }
    match /group_members/{m} {
      allow read: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid)
        || gOwner(resource.data.groupId) || gCoach(resource.data.groupId)
        || (gMember(resource.data.groupId) && resource.data.role == 'tecnico' && resource.data.ativo == true);
      allow create: if gMemberShape(request.resource.data,m) && (gAdmin()
        || (gAuth() && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'atleta'
          && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid)
        || gInvite(request.resource.data));
      allow update: if gMemberShape(request.resource.data,m)
        && request.resource.data.uid == resource.data.uid && request.resource.data.groupId == resource.data.groupId
        && (gAdmin()
          || (gOwner(resource.data.groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','ativo'])
            && resource.data.uid != gRoot(resource.data.groupId).ownerUid)
          || (gAuth() && resource.data.uid == request.auth.uid && resource.data.uid != gRoot(resource.data.groupId).ownerUid
            && request.resource.data.ativo == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']))
          || gInvite(request.resource.data));
      allow delete: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid
        && (gRoot(resource.data.groupId).ownerUid != request.auth.uid || gRoot(resource.data.groupId).arquivado == true));
    }
    match /group_invites/{i} {
      allow read: if gAdmin() || gOwner(resource.data.groupId) || (gAuth() && resource.data.email == request.auth.token.email.lower());
      allow create: if gOwner(request.resource.data.groupId) && gOpen(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId','groupName','email','role','status','expiraEm','criadoPor','criadoPorNome','criadoEm','aceitoPor'])
        && i.matches('[a-f0-9]{64}') && request.resource.data.email is string
        && request.resource.data.role in ['atleta','tecnico'] && request.resource.data.status == 'aberto'
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.aceitoPor == null
        && request.resource.data.expiraEm > request.time.toMillis()
        && request.resource.data.expiraEm <= request.time.toMillis() + 604800000;
      allow update: if (gOwner(resource.data.groupId) && request.resource.data.status == 'revogado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (gAuth() && resource.data.email == request.auth.token.email.lower() && resource.data.status == 'aberto'
          && resource.data.expiraEm > request.time.toMillis() && gOpen(resource.data.groupId)
          && request.resource.data.status == 'aceito' && request.resource.data.aceitoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','aceitoPor'])
          && getAfter(/databases/$(database)/documents/group_members/$(resource.data.groupId + '_' + request.auth.uid)).data.inviteId == i);
      allow delete: if gAdmin() || gOwner(resource.data.groupId) || (gAuth() && resource.data.email == request.auth.token.email.lower());
    }
    match /professionals/{u} {
      allow read: if gAdmin() || (gAuth() && (request.auth.uid == u || resource.data.status == 'aprovado'));
      allow create: if gAuth() && request.auth.uid == u && request.resource.data.uid == u
        && request.resource.data.keys().hasOnly(['uid','nome','cref','uf','status','fonte','verificadoPor','verificadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.verificadoPor == null && request.resource.data.verificadoEm == null && request.resource.data.fonte == null;
      allow update: if (gAdmin() && request.resource.data.uid == u)
        || (gAuth() && request.auth.uid == u && resource.data.status != 'aprovado'
          && request.resource.data.uid == u && request.resource.data.status == 'pendente'
          && request.resource.data.keys().hasOnly(['uid','nome','cref','uf','status','fonte','verificadoPor','verificadoEm'])
          && request.resource.data.verificadoPor == null && request.resource.data.verificadoEm == null && request.resource.data.fonte == null);
      allow delete: if gAdmin() || (gAuth() && request.auth.uid == u);
    }
    match /group_claims/{c} {
      allow read: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid);
      allow create, update: if gAdmin() || (gAuth() && request.resource.data.uid == request.auth.uid
        && c == request.resource.data.groupId + '_' + request.auth.uid && gOwner(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId','uid','contato','fonte','status']) && request.resource.data.status == 'pendente');
      allow delete: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid);
    }
    match /group_workouts/{t} {
      allow read: if gAdmin() || gOwner(resource.data.groupId) || gMember(resource.data.groupId);
      allow create: if (gAdmin() || gCoach(request.resource.data.groupId)) && gOpen(request.resource.data.groupId)
        && t.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['groupId','titulo','texto','data','piscina','autor','publishedBy','status','criadoEm'])
        && request.resource.data.publishedBy == request.auth.uid && request.resource.data.status == 'publicado'
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 100
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 12000
        && request.resource.data.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.piscina in ['SC25','LC50'];
      allow update: if (gAdmin() || gCoach(resource.data.groupId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelado';
      allow delete: if gAdmin();
    }
    match /group_records/{r} {
      allow read: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid) || gCoach(resource.data.groupId);
      allow create, update: if gAuth() && request.resource.data.uid == request.auth.uid && gMember(request.resource.data.groupId)
        && r == request.resource.data.workoutId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/group_workouts/$(request.resource.data.workoutId)).data.groupId == request.resource.data.groupId
        && request.resource.data.keys().hasOnly(['groupId','workoutId','uid','nome','titulo','data','feito','dur','rpe','tempos','atualizado'])
        && request.resource.data.feito is bool && request.resource.data.tempos is map
        && (request.resource.data.dur == null || (request.resource.data.dur >= 0 && request.resource.data.dur <= 1440))
        && (request.resource.data.rpe == null || (request.resource.data.rpe >= 0 && request.resource.data.rpe <= 10));
      allow delete: if gAdmin() || (gAuth() && resource.data.uid == request.auth.uid);
    }
    match /app_config/{c} {
      allow read: if gAuth();
      allow write: if gAdmin() && c == 'generator'
        && request.resource.data.keys().hasOnly(['status','versao','profissionalUid','profissionalNome','cref','aprovadoPor','aprovadoEm'])
        && request.resource.data.versao == 'g1' && request.resource.data.aprovadoPor == request.auth.uid
        && (request.resource.data.status == 'suspenso'
          || (request.resource.data.status == 'aprovado' && gProfessional(request.resource.data.profissionalUid)));
    }
    match /kv/{chave} {

      function logado()   { return request.auth != null; }
      function meuUid()   { return request.auth.uid; }
      function meuEmail() { return request.auth.token.email.lower(); }

      // A conta é indexada por e-mail: kUser = u_<email>.
      function minhaChaveU() { return 'u_' + meuEmail(); }
      function ehMeuU()      { return chave == minhaChaveU(); }

      // IMPORTANTE: durante o cadastro o u_ ainda não existe. Sem este guarda,
      // get() num documento inexistente derruba a avaliação inteira da regra.
      function temMeuDoc() { return logado()
        && exists(/databases/$(database)/documents/kv/$(minhaChaveU())); }
      function meuDoc()    { return get(/databases/$(database)/documents/kv/$(minhaChaveU())).data; }
      function aprovado()  { return temMeuDoc() && meuDoc().aprovado == true; }
      function minhaEq()   { return temMeuDoc() ? meuDoc().equipe : null; }
      // Quem administra a equipe. PRO é atleta competitivo, não gestor: só o
      // técnico aprovado da própria equipe recebe estes poderes. O administrador
      // global continua coberto separadamente por ehAdmin().
      function gestorDe(eq) {
        return aprovado() && eq != null && meuDoc().equipe == eq
          && meuDoc().perfil == 'tecnico';
      }
      function tecnicoDe(eq) { return gestorDe(eq); }
      // Administrador global. O e-mail vem do token assinado pelo Firebase Auth;
      // alterar HTML ou dados do perfil no cliente não concede este acesso.
      function ehAdmin() { return logado() && meuEmail() == 'barbato.bruno@gmail.com'; }
      function ehDev() { return ehAdmin(); }

      function ehPro() { return chave.matches('pro_.*'); }
      // Os dados pessoais não cabem mais num documento só: a Saúde mora em
      // pro_<uid>_sau e as versões diárias em pro_<uid>_bk<0-6>/_bkundo (v159,
      // v160). Exigir a chave EXATA `pro_<uid>` bloquearia os dois — e com
      // eles a separação que impede um defeito em Marcas de alcançar VFC,
      // sono e check-in, e o único histórico que o plano Spark permite.
      // O escopo continua sendo só o do próprio usuário: o prefixo é o uid do
      // token, e o `dono` do conteúdo é conferido do mesmo jeito.
      function ehMeuPro() { return logado()
        && ( chave == 'pro_' + meuUid() || chave.matches('pro_' + meuUid() + '_.*') ); }
      function ehTreinoPessoal() { return chave.matches('pt_.*'); }
      function ehMinhaChaveTreinoPessoal() {
        return logado() && chave.matches('pt_' + meuUid() + '_.*');
      }
      function ehMeuTreinoPessoal() {
        return ehMinhaChaveTreinoPessoal()
          && (!exists(/databases/$(database)/documents/kv/$(chave)) || resource.data.dono == meuUid());
      }
      function geracaoLiberada() {
        let versao = request.resource.data.get('geradorVersao',null);
        return versao == null || (gAuth()
          && get(/databases/$(database)/documents/app_config/generator).data.status == 'aprovado'
          && get(/databases/$(database)/documents/app_config/generator).data.versao == versao
          && gProfessional(get(/databases/$(database)/documents/app_config/generator).data.profissionalUid));
      }
      function ehU()   { return chave.matches('u_.*'); }
      function ehEq()  { return chave.matches('eq_.*'); }
      // Afiliação pública criada por atleta. É separada de `eq_`: não contém
      // treinos, não tem técnico e nunca concede gestão. A chave determinística
      // limita cada conta a um único registro público.
      function ehTime() { return chave.matches('time_.*'); }
      function ehMeuTime() { return logado() && chave == 'time_' + meuUid(); }
      function ehTimePublico() { return resource.data.get('categoria', null) == 'time'; }
      function ehOutro() { return !ehPro() && !ehTreinoPessoal() && !ehU() && !ehEq() && !ehTime(); }
      function ehCatalogo() { return chave == 'dev_equipes'; }

      // Documento da equipe em si (eq_<slug>, um único "_"). Precisa ser legível
      // por qualquer logado: no CADASTRO o app confere se a equipe existe antes
      // de o u_ do usuário ser criado — se isso falhar, ele duplica a equipe.
      function ehEqRaiz()   { return chave.matches('eq_[^_]+'); }
      // Onde o ATLETA escreve: os próprios tempos de treino e de competição.
      function ehEqAtleta() {
        return chave.matches('eq_[^_]+_tr_.*') || chave.matches('eq_[^_]+_cmp_.*');
      }
      // O atleta grava o PRÓPRIO snapshot de performance — é o que o técnico lê
      // (desempenho e carga, sem Saúde). A chave termina no uid dele.
      function meuPerf() { return minhaEq() != null
        && chave == 'eq_' + minhaEq() + '_perf_' + meuUid(); }
      // A lista de membros contém só aprovados. O próprio atleta aprovado pode
      // se remover ao sair; um pendente nunca escreve a lista compartilhada.
      function usersDaMinhaEq() { return minhaEq() != null
        && chave == 'eq_' + minhaEq() + '_users'; }

      function naoMexeEm(campo) {
        return request.resource.data[campo] == resource.data[campo];
      }

      // ───────────────────────── LEITURA ─────────────────────────
      allow read: if
        ehAdmin() ||
        // Vem antes das regras de perfil: estes documentos têm `perfil:null`;
        // numa consulta o Firestore não pode avaliar `null in [...]`.
        ( ehTimePublico() && logado() )
        // Transações precisam ler a ausência do documento antes de criá-lo.
        // Só o próprio namespace pode observar uma chave pessoal inexistente.
        || ( ehPro() && ehMeuPro() && !exists(/databases/$(database)/documents/kv/$(chave)) )
        // dados privados do atleta: dono; o administrador global é a exceção
        || ( ehPro() && logado() && resource.data.dono == meuUid() )
        || ( ehTreinoPessoal() && ehMeuTreinoPessoal() )
        // cadastro: o próprio, o técnico aprovado da equipe dele, ou o dev
        || ( ehU() && ( ehMeuU() || ehDev() || tecnicoDe(resource.data.equipe) ) )
        // consultas de gestores filtradas por equipe + perfil (atleta/PRO)
        || ( logado() && resource.data.perfil in ['atleta', 'pro']
             && tecnicoDe(resource.data.equipe) )
        // documento da equipe: qualquer logado (necessário no cadastro)
        || ( ehEqRaiz() && logado() )
        // lista de membros e meu próprio snapshot: mesmo pendente
        || ( ehEq() && logado() && ( (usersDaMinhaEq() && aprovado()) || meuPerf() ) )
        // demais documentos da equipe: membro APROVADO dela, ou o dev
        || ( ehEq() && ( ehDev() || ( aprovado() && resource.data.equipe == minhaEq() ) ) )
        || ( ehCatalogo() && logado() );

      // ──────────────────────── CRIAÇÃO ─────────────────────────
      allow create: if
        ehAdmin() ||
        ( ehPro() && ehMeuPro() && request.resource.data.dono == meuUid() )
        || ( ehTreinoPessoal() && ehMinhaChaveTreinoPessoal()
                                  && request.resource.data.dono == meuUid() && geracaoLiberada() )
        // cadastro: só o meu, e SEMPRE pendente (bloqueia autopromoção)
        || ( ehU() && ehMeuU()
             && request.resource.data.dono == meuUid()
             && request.resource.data.aprovado == false )
        // minha lista de membros / meu snapshot
        || ( ehEq() && aprovado() && ( meuPerf() || usersDaMinhaEq() ) )
        // documentos internos de equipe: gestor aprovado. A raiz eq_<slug>
        // só pode ser criada pelo administrador (já coberto no primeiro ramo).
        || ( ehEq() && !ehEqRaiz() && tecnicoDe(request.resource.data.equipe) )
        || ( ehTime() && ehMeuTime()
             && request.resource.data.dono == meuUid()
             && request.resource.data.donoEmail == null
             && request.resource.data.equipe == null
             && request.resource.data.perfil == null
             && request.resource.data.categoria == 'time' )
        || ( ehOutro() && ehAdmin() );

      // ─────────────────────── ATUALIZAÇÃO ──────────────────────
      allow update: if
        ehAdmin() ||
        ( ehPro() && ehMeuPro() && resource.data.dono == meuUid()
                              && request.resource.data.dono == meuUid() )
        || ( ehTreinoPessoal() && ehMeuTreinoPessoal()
                                  && request.resource.data.dono == meuUid()
                                  && (request.resource.data.get('geradorVersao',null) == resource.data.get('geradorVersao',null) || geracaoLiberada()) )
        // o próprio cadastro: edita os dados, mas NÃO sobe o próprio privilégio.
        // `aprovado` só fica igual ou cai para false.
        || ( ehU() && ehMeuU() && naoMexeEm('dono') && naoMexeEm('perfil')
             && ( naoMexeEm('equipe') || request.resource.data.aprovado == false )
             && ( naoMexeEm('aprovado')
                  || request.resource.data.aprovado == false ) )
        // o dev libera técnicos (sem mexer em dono nem perfil)
        || ( ehU() && ehDev() && naoMexeEm('dono') && naoMexeEm('perfil') )
        // o técnico aprova / inclui / exclui atletas comuns ou PRO da SUA equipe
        || ( ehU() && resource.data.perfil in ['atleta', 'pro'] && naoMexeEm('dono') && naoMexeEm('perfil')
             && ( tecnicoDe(resource.data.equipe) || tecnicoDe(request.resource.data.equipe) ) )
        // minha lista de membros / meu snapshot de performance
        || ( ehEq() && aprovado() && ( meuPerf() || usersDaMinhaEq() ) )
        // treino/competição: membro aprovado da equipe lança os seus tempos
        || ( ehEqAtleta() && aprovado() && resource.data.equipe == minhaEq()
             && naoMexeEm('equipe') )
        // demais documentos da equipe: só o técnico (ou o dono da equipe)
        || ( ehEq() && !ehEqAtleta() && naoMexeEm('equipe')
             && tecnicoDe(resource.data.equipe) )
        || ( ehTime() && ehMeuTime() && resource.data.dono == meuUid()
             && request.resource.data.dono == meuUid() && naoMexeEm('dono')
             && naoMexeEm('categoria') )
        || ( ehOutro() && ehAdmin() );

      // ───────────────────────── EXCLUSÃO ───────────────────────
      allow delete: if
        ehAdmin()
        || ( ehPro() && ehMeuPro() && resource.data.dono == meuUid() )
        || ( ehTreinoPessoal() && ehMeuTreinoPessoal() )
        || ( ehU() && ( ehMeuU() || ehDev() || (resource.data.perfil in ['atleta', 'pro'] && tecnicoDe(resource.data.equipe)) ) )
        // o próprio snapshot: sem isto, quem apaga a conta deixa para trás o
        // painel que o técnico enxerga (LGPD art. 18, e exigência das lojas).
        // É só o DELE: meuPerf() casa a chave com o uid do token.
        || ( ehEq() && meuPerf() )
        || ( ehEq() && tecnicoDe(resource.data.equipe) )
        || ( ehTime() && ehMeuTime() && resource.data.dono == meuUid() )
        || ( ehOutro() && ehAdmin() );
    }
  }
}

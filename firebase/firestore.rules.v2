rules_version = '2';

// PARCIAL — regras do Firestore, VERSÃO 2 (correção do P0).
//
// ⚠️ NÃO PUBLIQUE ESTE ARQUIVO AINDA. Ordem obrigatória:
//   Fase 1 — todos os clientes na v69+ (passam a gravar os campos espelhados).
//   Fase 2 — Diagnóstico › "Migrar campos de segurança" (preenche os documentos antigos).
//   Fase 3 — só então publicar este conteúdo.
// Publicar antes da Fase 2 TRANCA TODOS OS USUÁRIOS PARA FORA (perfil viria vazio).
// Rollback: republicar `firestore.rules` (a versão anterior) — leva 30 segundos.
//
// O QUE MUDA
//   Antes: qualquer pessoa logada lia, alterava e APAGAVA tudo que não fosse pro_*.
//          Como o cadastro é aberto, isso valia para qualquer um na internet.
//   Agora: o acesso é por DONO e por EQUIPE, e quem não foi aprovado não lê nada.
//
// POR QUE OS CAMPOS ESPELHADOS
//   O app grava o conteúdo como string JSON em `v`, e as regras não sabem ler
//   JSON dentro de string. Por isso `dono`, `equipe`, `perfil` e `aprovado`
//   existem como campos reais do documento (ver camposSeguranca() no index.html).
//   É o que permite exigir "você não pode mudar o seu próprio perfil".

service cloud.firestore {
  match /databases/{database}/documents {
    match /kv/{chave} {

      function logado()   { return request.auth != null; }
      function meuUid()   { return request.auth.uid; }
      function meuEmail() { return request.auth.token.email.lower(); }

      // A conta é indexada por e-mail: kUser = u_<email>.
      function minhaChaveU() { return 'u_' + meuEmail(); }
      function ehMeuU()      { return chave == minhaChaveU(); }

      // Perfil confiável: vem do MEU cadastro, que eu não posso alterar (ver update de u_).
      function meuDoc()   { return get(/databases/$(database)/documents/kv/$(minhaChaveU())).data; }
      function aprovado() { return logado() && meuDoc().aprovado == true; }
      function minhaEq()  { return meuDoc().equipe; }
      function tecnicoDe(eq) {
        return aprovado() && meuDoc().perfil == 'tecnico' && eq != null && meuDoc().equipe == eq;
      }
      // Dev: ferramentas de diagnóstico/recuperação. Sem acesso a pro_ (dados de saúde).
      function ehDev() { return logado() && meuEmail() == 'barbato.bruno@gmail.com'; }

      function ehPro() { return chave.matches('pro_.*'); }
      function ehU()   { return chave.matches('u_.*'); }
      function ehEq()  { return chave.matches('eq_.*'); }
      // Documentos de equipe em que o ATLETA precisa escrever (lança os próprios
      // tempos de treino e de competição). Os demais eq_* são só do técnico.
      function ehEqAtleta() {
        return chave.matches('eq_[^_]+_tr_.*') || chave.matches('eq_[^_]+_cmp_.*');
      }

      // Campos de autorização não podem ser forjados por quem escreve.
      function naoMexeEm(campo) {
        return request.resource.data[campo] == resource.data[campo];
      }

      // ───────────────────────── LEITURA ─────────────────────────
      allow read: if
        // dados privados do atleta: só o dono (nem técnico, nem dev)
        ( ehPro() && logado() && resource.data.dono == meuUid() )
        // cadastro: o próprio, ou o técnico aprovado da equipe dele, ou o dev
        || ( ehU() && ( ehMeuU() || tecnicoDe(resource.data.equipe) || ehDev() ) )
        // equipe: membros aprovados daquela equipe, ou o dev
        || ( ehEq() && ( ( aprovado() && resource.data.equipe == minhaEq() ) || ehDev() ) )
        // qualquer outra chave (config global etc.): logado
        || ( !ehPro() && !ehU() && !ehEq() && logado() );

      // ──────────────────────── CRIAÇÃO ─────────────────────────
      allow create: if
        // pro_: só o próprio dono
        ( ehPro() && logado() && request.resource.data.dono == meuUid() )
        // cadastro: só o meu, já nascendo NÃO aprovado (evita autopromoção)
        || ( ehU() && ehMeuU()
             && request.resource.data.dono == meuUid()
             && request.resource.data.aprovado == false )
        // documentos de equipe: técnico aprovado da equipe
        || ( ehEq() && tecnicoDe(request.resource.data.equipe) )
        || ( !ehPro() && !ehU() && !ehEq() && logado() );

      // ─────────────────────── ATUALIZAÇÃO ──────────────────────
      allow update: if
        ( ehPro() && logado() && resource.data.dono == meuUid()
                              && request.resource.data.dono == meuUid() )
        // o próprio cadastro: pode editar os dados, MAS perfil e aprovado ficam congelados
        || ( ehU() && ehMeuU() && naoMexeEm('dono')
             && naoMexeEm('perfil') && naoMexeEm('aprovado') )
        // o técnico aprova / inclui / exclui atletas da SUA equipe (não mexe em perfil)
        || ( ehU() && naoMexeEm('dono') && naoMexeEm('perfil')
             && ( tecnicoDe(resource.data.equipe) || tecnicoDe(request.resource.data.equipe) ) )
        // treino/competição: qualquer membro aprovado da equipe (lança os próprios tempos)
        || ( ehEqAtleta() && aprovado() && resource.data.equipe == minhaEq()
             && naoMexeEm('equipe') )
        // demais documentos da equipe: só o técnico
        || ( ehEq() && !ehEqAtleta() && tecnicoDe(resource.data.equipe) && naoMexeEm('equipe') )
        || ( !ehPro() && !ehU() && !ehEq() && logado() );

      // ───────────────────────── EXCLUSÃO ───────────────────────
      allow delete: if
        ( ehPro() && logado() && resource.data.dono == meuUid() )
        || ( ehU() && ( ehMeuU() || tecnicoDe(resource.data.equipe) ) )
        || ( ehEq() && tecnicoDe(resource.data.equipe) )
        || ( !ehPro() && !ehU() && !ehEq() && logado() );
    }
  }
}

// ─────────────────────────── PONTO EM ABERTO ───────────────────────────
// Hoje o app AUTO-APROVA quem digita o código da equipe (index.html: u.aprovado=true
// ao entrar numa equipe). As regras acima não permitem isso: o próprio usuário não
// pode se marcar como aprovado, porque o código da equipe está dentro de `v` e as
// regras não conseguem conferi-lo.
// Duas saídas, a decidir com o Bruno:
//   (a) entrar na equipe passa a deixar `aprovado=false` e o técnico confirma na
//       tela que já existe ("pendentes"). Mais seguro; um clique a mais para o técnico.
//   (b) espelhar também o `codigo` da equipe como campo real e deixar a regra
//       conferir o código enviado. Mantém o fluxo atual, mas expõe o código a quem
//       ler o documento da equipe.
// Recomendação: (a).

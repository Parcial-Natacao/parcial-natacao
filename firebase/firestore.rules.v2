rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════╗
// ║  ESTE ARQUIVO É DO **FIRESTORE**, NÃO DO STORAGE.                    ║
// ║  Cole SOMENTE em: Console › Firestore Database › aba "Regras".       ║
// ║  Confira antes de publicar: a linha abaixo diz `cloud.firestore`.    ║
// ╚══════════════════════════════════════════════════════════════════════╝

// PARCIAL — regras do Firestore, VERSÃO 2 (correção do P0). FECHADA.
//
// ⚠️ ORDEM OBRIGATÓRIA PARA PUBLICAR:
//   Fase 1 — todos os clientes na v69+ (gravam os campos espelhados).  [feito]
//   Fase 2 — Diagnóstico › "Migrar campos de segurança" até dar verde.  [feito]
//   Fase 3 — publicar este conteúdo no Console › Firestore › Regras.
// Também é preciso estar na v73+ do app: antes dela, seis telas liam a coleção
// INTEIRA, o que estas regras negam (ver varrerKv no index.html).
// Rollback: republicar `firestore.rules` (versão anterior) — 30 segundos.
//
// O QUE MUDA
//   Antes: qualquer pessoa logada lia, alterava e APAGAVA tudo que não fosse
//          pro_*. Como o cadastro é aberto, isso valia para qualquer um.
//   Agora: acesso por DONO e por EQUIPE. Quem não foi aprovado não lê a equipe.
//
// POR QUE OS CAMPOS ESPELHADOS
//   O app grava o conteúdo como string JSON em `v`, e as regras não sabem ler
//   JSON dentro de string. Por isso `dono`, `donoEmail`, `equipe`, `perfil` e
//   `aprovado` existem como campos reais (ver camposSeguranca no index.html).
//
// APROVAÇÃO
//   Ninguém nasce aprovado. Entrar numa equipe deixa o cadastro PENDENTE; o
//   técnico libera o atleta e o dev libera o técnico. Única exceção: quem CRIA
//   a equipe é dono dela (donoEmail) e se auto-aprova nela.

service cloud.firestore {
  match /databases/{database}/documents {
    match /kv/{chave} {

      function logado()   { return request.auth != null; }
      function meuUid()   { return request.auth.uid; }
      function meuEmail() { return request.auth.token.email.lower(); }

      // A conta é indexada por e-mail: kUser = u_<email>.
      function minhaChaveU() { return 'u_' + meuEmail(); }
      function ehMeuU()      { return chave == minhaChaveU(); }

      // IMPORTANTE: durante o cadastro o u_ ainda não existe. Sem este guarda,
      // get() num documento inexistente derruba a avaliação inteira da regra.
      function temMeuDoc() { return logado()
        && exists(/databases/$(database)/documents/kv/$(minhaChaveU())); }
      function meuDoc()    { return get(/databases/$(database)/documents/kv/$(minhaChaveU())).data; }
      function aprovado()  { return temMeuDoc() && meuDoc().aprovado == true; }
      function minhaEq()   { return temMeuDoc() ? meuDoc().equipe : null; }
      // Quem administra a equipe. ATENÇÃO: no app isso não é só o perfil
      // 'tecnico' — um atleta PRO com "Gestão de equipe" ativada faz o mesmo
      // papel (ehGestor() no index.html). A gestão é um botão no cliente, que a
      // regra não enxerga; o que dá para exigir é perfil PRO, aprovado e da
      // MESMA equipe. Sem isso, o PRO em gestão perde a equipe inteira.
      function gestorDe(eq) {
        return aprovado() && eq != null && meuDoc().equipe == eq
          && ( meuDoc().perfil == 'tecnico' || meuDoc().perfil == 'pro' );
      }
      function tecnicoDe(eq) { return gestorDe(eq); }
      // Dono da equipe: quem a criou. Só para a auto-aprovação inicial.
      function souDonoDaEquipe(eq) {
        return eq != null
          && exists(/databases/$(database)/documents/kv/$('eq_' + eq))
          && get(/databases/$(database)/documents/kv/$('eq_' + eq)).data.donoEmail == meuEmail();
      }
      function ehDev() { return logado() && meuEmail() == 'barbato.bruno@gmail.com'; }

      function ehPro() { return chave.matches('pro_.*'); }
      function ehU()   { return chave.matches('u_.*'); }
      function ehEq()  { return chave.matches('eq_.*'); }
      function ehOutro() { return !ehPro() && !ehU() && !ehEq(); }

      // Documento da equipe em si (eq_<slug>, um único "_"). Precisa ser legível
      // por qualquer logado: no CADASTRO o app confere se a equipe existe antes
      // de o u_ do usuário ser criado — se isso falhar, ele duplica a equipe.
      function ehEqRaiz()   { return chave.matches('eq_[^_]+'); }
      // Onde o ATLETA escreve: os próprios tempos de treino e de competição.
      function ehEqAtleta() {
        return chave.matches('eq_[^_]+_tr_.*') || chave.matches('eq_[^_]+_cmp_.*');
      }
      // O atleta grava o PRÓPRIO snapshot de performance — é o que o técnico lê
      // (desempenho e carga, sem Saúde). A chave termina no uid dele.
      function meuPerf() { return minhaEq() != null
        && chave == 'eq_' + minhaEq() + '_perf_' + meuUid(); }
      // A lista de membros: no cadastro o usuário se acrescenta (ainda pendente)
      // e ao sair da equipe se remove. Por isso não exige aprovação.
      function usersDaMinhaEq() { return minhaEq() != null
        && chave == 'eq_' + minhaEq() + '_users'; }

      function naoMexeEm(campo) {
        return request.resource.data[campo] == resource.data[campo];
      }

      // ───────────────────────── LEITURA ─────────────────────────
      allow read: if
        // dados privados do atleta: só o dono (nem técnico, nem dev)
        ( ehPro() && logado() && resource.data.dono == meuUid() )
        // cadastro: o próprio, o técnico aprovado da equipe dele, ou o dev
        || ( ehU() && ( ehMeuU() || ehDev() || tecnicoDe(resource.data.equipe) ) )
        // documento da equipe: qualquer logado (necessário no cadastro)
        || ( ehEqRaiz() && logado() )
        // lista de membros e meu próprio snapshot: mesmo pendente
        || ( ehEq() && logado() && ( usersDaMinhaEq() || meuPerf() ) )
        // demais documentos da equipe: membro APROVADO dela, ou o dev
        || ( ehEq() && ( ehDev() || ( aprovado() && resource.data.equipe == minhaEq() ) ) )
        || ( ehOutro() && logado() );

      // ──────────────────────── CRIAÇÃO ─────────────────────────
      allow create: if
        ( ehPro() && logado() && request.resource.data.dono == meuUid() )
        // cadastro: só o meu, e SEMPRE pendente (bloqueia autopromoção)
        || ( ehU() && ehMeuU()
             && request.resource.data.dono == meuUid()
             && request.resource.data.aprovado == false )
        // minha lista de membros / meu snapshot
        || ( ehEq() && logado() && ( meuPerf() || usersDaMinhaEq() ) )
        // equipe nova: quem cria vira dono dela; dentro de equipe existente,
        // só o técnico dela (ou o dono).
        || ( ehEq() && logado()
             && ( request.resource.data.donoEmail == meuEmail()
                  || tecnicoDe(request.resource.data.equipe)
                  || souDonoDaEquipe(request.resource.data.equipe) ) )
        || ( ehOutro() && logado() );

      // ─────────────────────── ATUALIZAÇÃO ──────────────────────
      allow update: if
        ( ehPro() && logado() && resource.data.dono == meuUid()
                              && request.resource.data.dono == meuUid() )
        // o próprio cadastro: edita os dados, mas NÃO sobe o próprio privilégio.
        // `aprovado` só fica igual, cai para false, ou sobe se eu for dono da equipe.
        || ( ehU() && ehMeuU() && naoMexeEm('dono') && naoMexeEm('perfil')
             && ( naoMexeEm('aprovado')
                  || request.resource.data.aprovado == false
                  || souDonoDaEquipe(request.resource.data.equipe) ) )
        // o dev libera técnicos (sem mexer em dono nem perfil)
        || ( ehU() && ehDev() && naoMexeEm('dono') && naoMexeEm('perfil') )
        // o técnico aprova / inclui / exclui atletas da SUA equipe
        || ( ehU() && naoMexeEm('dono') && naoMexeEm('perfil')
             && ( tecnicoDe(resource.data.equipe) || tecnicoDe(request.resource.data.equipe) ) )
        // minha lista de membros / meu snapshot de performance
        || ( ehEq() && logado() && ( meuPerf() || usersDaMinhaEq() ) )
        // treino/competição: membro aprovado da equipe lança os seus tempos
        || ( ehEqAtleta() && aprovado() && resource.data.equipe == minhaEq()
             && naoMexeEm('equipe') )
        // demais documentos da equipe: só o técnico (ou o dono da equipe)
        || ( ehEq() && !ehEqAtleta() && naoMexeEm('equipe')
             && ( tecnicoDe(resource.data.equipe) || souDonoDaEquipe(resource.data.equipe) ) )
        || ( ehOutro() && logado() );

      // ───────────────────────── EXCLUSÃO ───────────────────────
      allow delete: if
        ( ehPro() && logado() && resource.data.dono == meuUid() )
        || ( ehU() && ( ehMeuU() || ehDev() || tecnicoDe(resource.data.equipe) ) )
        || ( ehEq() && ( tecnicoDe(resource.data.equipe) || souDonoDaEquipe(resource.data.equipe) ) )
        || ( ehOutro() && logado() );
    }
  }
}

rules_version = '2';

// PARCIAL — regras do Firebase STORAGE (anexos).
//
// ⚠️ São SEPARADAS das regras do Firestore e publicadas em outro lugar:
//    Console do Firebase › Storage › aba "Rules" › Publicar.
//    Publicar as do Firestore NÃO protege os arquivos, e vice-versa.
//
// Antes, fotos e PDFs iam em base64 dentro do documento (teto de 1 MiB, com
// risco de o app parar de salvar). Agora vão para cá, e o documento guarda só
// a URL. O modelo de acesso acompanha o do Firestore:
//
//   pro/<uid>/...  → dados pessoais do atleta: SÓ O DONO. Nem técnico, nem dev.
//   eq/<slug>/...  → material da equipe: membro aprovado lê, gestor escreve.
//
// O papel vem do documento kv/u_<email> no Firestore — o mesmo que as regras
// do Firestore usam, e que o usuário não pode alterar (perfil e aprovado são
// congelados lá).

service firebase.storage {
  match /b/{bucket}/o {

    function logado()   { return request.auth != null; }
    function meuUid()   { return request.auth.uid; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function chaveU()   { return /databases/(default)/documents/kv/$('u_' + meuEmail()); }
    // durante o cadastro o u_ pode ainda não existir: sem este guarda, o get()
    // derruba a avaliação inteira da regra.
    function temDoc()   { return logado() && firestore.exists(chaveU()); }
    function meuDoc()   { return firestore.get(chaveU()).data; }
    function aprovado() { return temDoc() && meuDoc().aprovado == true; }
    function minhaEq()  { return temDoc() ? meuDoc().equipe : null; }
    function gestorDe(eq) {
      return aprovado() && eq != null && meuDoc().equipe == eq
        && ( meuDoc().perfil == 'tecnico' || meuDoc().perfil == 'pro' );
    }

    // Limites: o app já reduz a foto (760px) e recusa PDF acima de 500 KB,
    // mas a regra é a única barreira contra um cliente fora do app.
    function tamanhoOk()  { return request.resource.size < 8 * 1024 * 1024; }
    function tipoOk()     { return request.resource.contentType.matches('application/pdf')
                              || request.resource.contentType.matches('image/(png|jpeg|webp)'); }

    // ── Anexos pessoais do atleta (sessões fora d'água) ──
    match /pro/{uid}/{arquivo=**} {
      allow read:   if logado() && meuUid() == uid;
      allow write:  if logado() && meuUid() == uid && tamanhoOk() && tipoOk();
      allow delete: if logado() && meuUid() == uid;
    }

    // ── Material da equipe (PDF do treino) ──
    match /eq/{slug}/{arquivo=**} {
      allow read:   if aprovado() && minhaEq() == slug;
      allow write:  if gestorDe(slug) && tamanhoOk() && tipoOk();
      allow delete: if gestorDe(slug);
    }

    // Nada mais é acessível.
    match /{outros=**} {
      allow read, write: if false;
    }
  }
}
